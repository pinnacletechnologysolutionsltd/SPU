; orientation.spu - exact 2D orientation in Q(sqrt3) (Program A, ISA draft §7.1, case A)
; Points A = (0, 0), B = (2, sqrt3), C = (1, 2 sqrt3). det = (B-A) x (C-A) = 2*2sqrt3 - sqrt3*1 = 3 sqrt3 > 0: CCW.
; Result: S7 = +1 CCW, -1 CW, 0 collinear, 2 refused (any arithmetic refusal in the run).
.profile programmable-surd

        LOADT S0, 0, 0, 1       ; ax = 0
        LOADT S1, 0, 0, 1       ; ay = 0
        LOADT S2, 2, 0, 1       ; bx = 2
        LOADT S3, 0, 1, 1       ; by = sqrt3
        LOADT S4, 1, 0, 1       ; cx = 1
        LOADT S5, 0, 2, 1       ; cy = 2 sqrt3

        SSUB S2, S2, S0         ; bx - ax
        SSUB S4, S4, S0         ; cx - ax
        SSUB S3, S3, S1         ; by - ay
        SSUB S5, S5, S1         ; cy - ay
        SMUL S0, S2, S5
        SMUL S1, S3, S4
        SSUB S0, S0, S1         ; det
        BR   RS, refused        ; never classify a value whose computation may have refused
        STST S0
        BR   GT, ccw
        BR   LT, cw
        SLIK S7, 0              ; collinear
        HALT
ccw:    SLIK S7, 1
        HALT
cw:     SLIK S7, -1
        HALT
refused: SLIK S7, 2
        HALT
