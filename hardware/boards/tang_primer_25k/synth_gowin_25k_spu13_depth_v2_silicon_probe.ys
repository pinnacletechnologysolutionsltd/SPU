# synth_gowin_25k_spu13_depth_v2_silicon_probe.ys — depth-v2 first
# silicon verification

read_verilog -lib +/gowin/cells_xtra_gw5a.v

read_verilog hardware/boards/tang_primer_25k/spu13_tang25k_depth_v2_silicon_probe.v \
    hardware/rtl/gpu/spu_depth_dispatch.v \
    hardware/rtl/gpu/spu_depth_math.v \
    hardware/rtl/gpu/spu_reciprocal_core.v \
    hardware/rtl/gpu/spu_shared_mult35.v \
    hardware/rtl/gpu/spu_attr_stepper.v

hierarchy -top spu13_tang25k_depth_v2_silicon_probe
synth_gowin -family gw5a -top spu13_tang25k_depth_v2_silicon_probe \
    -json build/spu13_depth_v2_silicon_probe.json -run begin:map_cells
techmap -map +/gowin/cells_map.v
opt_lut_ins -tech gowin
hilomap -singleton -hicell VCC V -locell GND G
clean
hierarchy -check
check -noinit
blackbox =A:whitebox
write_json build/spu13_depth_v2_silicon_probe.json
