# synth_gowin_25k_spu13_mult35_probe.ys — corrected shared-multiplier isolation probe

read_verilog -lib +/gowin/cells_xtra_gw5a.v

read_verilog hardware/boards/tang_primer_25k/spu13_tang25k_mult35_probe.v

hierarchy -top spu13_tang25k_mult35_probe
synth_gowin -family gw5a -top spu13_tang25k_mult35_probe \
    -json build/spu13_mult35_probe.json -run begin:map_cells
techmap -map +/gowin/cells_map.v
opt_lut_ins -tech gowin
hilomap -singleton -hicell VCC V -locell GND G
clean
hierarchy -check
check -noinit
blackbox =A:whitebox
write_json build/spu13_mult35_probe.json
