# synth_gowin_25k_spu13_gpu_raster_probe.ys — GPU rasterizer coverage-path area probe

read_verilog -lib +/gowin/cells_xtra_gw5a.v

read_verilog hardware/boards/tang_primer_25k/spu13_tang25k_gpu_raster_probe.v \
    hardware/rtl/gpu/spu_video_timing.v \
    hardware/rtl/gpu/spu_dual_raster.v \
    hardware/rtl/gpu/spu_raster_unit.v \
    hardware/rtl/gpu/spu_edge_stepper.v

hierarchy -top spu13_tang25k_gpu_raster_probe
synth_gowin -family gw5a -top spu13_tang25k_gpu_raster_probe \
    -json build/spu13_gpu_raster_probe.json -run begin:map_cells
techmap -map +/gowin/cells_map.v
opt_lut_ins -tech gowin
hilomap -singleton -hicell VCC V -locell GND G
clean
hierarchy -check
check -noinit
blackbox =A:whitebox
write_json build/spu13_gpu_raster_probe.json
