read_verilog -lib +/xilinx/cells_sim.v
read_verilog -sv hardware/rtl/gpu/spu_video_timing.v
read_verilog -sv hardware/rtl/gpu/spu_edge_stepper.v
read_verilog -sv hardware/rtl/gpu/spu_attr_stepper.v
read_verilog -sv hardware/rtl/gpu/spu_raster_unit.v
read_verilog -sv hardware/rtl/gpu/spu_dual_raster.v
read_verilog -sv hardware/rtl/gpu/spu_depth_compare.v
read_verilog -sv hardware/rtl/gpu/spu_depth_math.v
read_verilog -sv hardware/rtl/gpu/spu_depth_dispatch.v
read_verilog -sv hardware/rtl/gpu/spu_reciprocal_core.v
read_verilog -sv hardware/rtl/gpu/spu_shared_mult35.v
read_verilog -sv hardware/rtl/hal/hal_vga.v
read_verilog -sv hardware/rtl/gpu/spu_gpu_top.v
read_verilog -sv -D SYNTHESIS hardware/boards/artix7/spu_a7_gpu_vga_top.v

# Prune to the real top before synth_xilinx runs its own hierarchy pass.
# spu_gpu_top's DEVICE parameter has no valid default by design, so its
# default-parameter elaboration is deliberately invalid; without this prune
# yosys tries to elaborate it standalone and fails on a module that this
# design never instantiates.
hierarchy -top spu_a7_gpu_vga_top
