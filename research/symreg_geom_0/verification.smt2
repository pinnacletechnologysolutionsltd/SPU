; 4-bit signed input coefficients widened to 16 bits before multiplication.
; For a+b√3, Q coefficients are a²+3b² and 2ab.
(set-logic QF_BV)
(declare-const a (_ BitVec 4))
(declare-const b (_ BitVec 4))
(declare-const c (_ BitVec 4))
(declare-const d (_ BitVec 4))
(define-fun A () (_ BitVec 16) ((_ sign_extend 12) a))
(define-fun B () (_ BitVec 16) ((_ sign_extend 12) b))
(define-fun C () (_ BitVec 16) ((_ sign_extend 12) c))
(define-fun D () (_ BitVec 16) ((_ sign_extend 12) d))
(define-fun q0 ((x (_ BitVec 16)) (y (_ BitVec 16))) (_ BitVec 16)
  (bvadd (bvmul x x) (bvmul (_ bv3 16) (bvmul y y))))
(define-fun q1 ((x (_ BitVec 16)) (y (_ BitVec 16))) (_ BitVec 16)
  (bvmul (_ bv2 16) (bvmul x y)))
(define-fun before0 () (_ BitVec 16) (bvadd (q0 A B) (q0 C D)))
(define-fun before1 () (_ BitVec 16) (bvadd (q1 A B) (q1 C D)))
(define-fun turn0 () (_ BitVec 16) (bvadd (q0 (bvneg C) (bvneg D)) (q0 A B)))
(define-fun turn1 () (_ BitVec 16) (bvadd (q1 (bvneg C) (bvneg D)) (q1 A B)))
(push)
(assert (or (distinct before0 turn0) (distinct before1 turn1)))
(check-sat)
(pop)
; Incorrect scaling transform (2x,y); find a concrete violation.
(push)
(assert (or (distinct before0 (bvadd (q0 (bvmul (_ bv2 16) A) (bvmul (_ bv2 16) B)) (q0 C D)))
            (distinct before1 (bvadd (q1 (bvmul (_ bv2 16) A) (bvmul (_ bv2 16) B)) (q1 C D)))))
(check-sat)
(get-value (a b c d))
(pop)
