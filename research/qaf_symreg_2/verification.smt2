; 3-bit signed inputs and scales, widened to 16 bits; all integer intermediates fit.
(set-logic QF_BV)
(declare-const a (_ BitVec 3))
(declare-const b (_ BitVec 3))
(declare-const k (_ BitVec 3))
(declare-const j (_ BitVec 3))
(declare-const f Bool)
(declare-const g Bool)
(define-fun sx ((x (_ BitVec 3))) (_ BitVec 16) ((_ sign_extend 13) x))
(define-fun flip ((x (_ BitVec 16)) (p Bool)) (_ BitVec 16) (ite p (bvneg x) x))
(define-fun norm ((x (_ BitVec 16)) (y (_ BitVec 16))) (_ BitVec 16)
  (bvsub (bvmul x x) (bvmul (_ bv3 16) (bvmul y y))))
(define-fun allowed ((x (_ BitVec 3))) Bool
  (or (= x #b110) (= x #b111) (= x #b000) (= x #b001) (= x #b010)))
; Composition and conjugation parity: no mismatch expected.
(assert (allowed k))
(assert (allowed j))
(assert (or (distinct (bvmul (sx j) (bvmul (sx k) (sx a)))
                      (bvmul (bvmul (sx j) (sx k)) (sx a)))
            (distinct (bvmul (sx j) (flip (bvmul (sx k) (flip (sx b) f)) g))
                      (bvmul (bvmul (sx j) (sx k)) (flip (sx b) (xor f g))))))
(check-sat)
; Mutant OR instead of XOR: repeated conjugation counterexample.
(reset-assertions)
(assert (= b #b001)) (assert (= k #b001)) (assert (= j #b001))
(assert f) (assert g)
(assert (distinct (bvmul (sx j) (flip (bvmul (sx k) (flip (sx b) f)) g))
                  (bvmul (bvmul (sx j) (sx k)) (flip (sx b) (or f g)))))
(check-sat)
(get-value (b k j f g))
; Norm scales by k², including zero and negative k.
(reset-assertions)
(assert (allowed k))
(assert (distinct (norm (bvmul (sx k) (sx a)) (bvmul (sx k) (flip (sx b) f)))
                  (bvmul (bvmul (sx k) (sx k)) (norm (sx a) (sx b)))))
(check-sat)
; Mutant norm factor k rather than k².
(reset-assertions)
(assert (= a #b001)) (assert (= b #b000)) (assert (= k #b010))
(assert (distinct (norm (bvmul (sx k) (sx a)) (bvmul (sx k) (sx b)))
                  (bvmul (sx k) (norm (sx a) (sx b)))))
(check-sat)
(get-value (a b k))
; A conjugation cycle is consistent: conj(conj(x)) = x.
(reset-assertions)
(assert (distinct (flip (flip (sx b) true) true) (sx b)))
(check-sat)
; A contradictory equality y=x may be proposed despite y=conj(x).
(reset-assertions)
(assert (= b #b001))
(assert (distinct (sx b) (flip (sx b) true)))
(check-sat)
(get-value (b))
; One version increment blocks a historical identity from matching a new one.
(reset-assertions)
(declare-const old_id (_ BitVec 2))
(define-fun new_id () (_ BitVec 2) (bvadd old_id (_ bv1 2)))
(assert (= old_id new_id))
(check-sat)
; Defective register-only matching ignores changed versions and admits a witness.
(reset-assertions)
(assert (distinct old_id new_id))
(check-sat)
(get-value (old_id new_id))
