; 4-bit signed a,b,k; k in {-2,-1,0,1,2}; all arithmetic widened to 32 bits.
; Check N(k*conj(x)) = k^2*N(x); all integer intermediates fit 32 bits.
(set-logic QF_BV)
(declare-const a (_ BitVec 4))
(declare-const b (_ BitVec 4))
(declare-const k (_ BitVec 4))
(define-fun s ((x (_ BitVec 4))) (_ BitVec 32) ((_ sign_extend 28) x))
(define-fun sq ((x (_ BitVec 32))) (_ BitVec 32) (bvmul x x))
(define-fun norm ((x (_ BitVec 32)) (y (_ BitVec 32))) (_ BitVec 32)
  (bvsub (sq x) (bvmul (_ bv3 32) (sq y))))
(assert (or (= k #xe) (= k #xf) (= k #x0) (= k #x1) (= k #x2)))
(assert (distinct (norm (bvmul (s k) (s a)) (bvneg (bvmul (s k) (s b))))
                  (bvmul (sq (s k)) (norm (s a) (s b)))))
(check-sat)
; Equal norm does not imply equality: 1+sqrt(3), 1-sqrt(3).
(reset-assertions)
(assert (= a #x1))
(assert (= b #x1))
(assert (= (norm (s a) (s b)) (norm (s a) (bvneg (s b)))))
(assert (distinct (s b) (bvneg (s b))))
(check-sat)
; Mutant uses k instead of k² for the norm scale.
(reset-assertions)
(assert (= a #x1))
(assert (= b #x0))
(assert (= k #x2))
(assert (distinct (norm (bvmul (s k) (s a)) (bvneg (bvmul (s k) (s b))))
                  (bvmul (s k) (norm (s a) (s b)))))
(check-sat)
(get-value (a b k))
