; 4-bit signed coefficients, 4-bit positive unsigned denominators.
; Arithmetic is widened to 32 bits; all possible products fit that width.
(set-logic QF_BV)
(declare-const a1 (_ BitVec 4))
(declare-const b1 (_ BitVec 4))
(declare-const d1 (_ BitVec 4))
(declare-const a2 (_ BitVec 4))
(declare-const b2 (_ BitVec 4))
(declare-const d2 (_ BitVec 4))
(define-fun s ((x (_ BitVec 4))) (_ BitVec 32) ((_ sign_extend 28) x))
(define-fun u ((x (_ BitVec 4))) (_ BitVec 32) ((_ zero_extend 28) x))
(define-fun n ((a (_ BitVec 4)) (b (_ BitVec 4))) (_ BitVec 32)
  (bvsub (bvmul (s a) (s a)) (bvmul (_ bv3 32) (bvmul (s b) (s b)))))
(assert (distinct d1 (_ bv0 4)))
(assert (distinct d2 (_ bv0 4)))
(assert (= (bvmul (s a1) (u d2)) (bvmul (s a2) (u d1))))
(assert (= (bvmul (s b1) (u d2)) (bvmul (s b2) (u d1))))
(assert (distinct (bvmul (n a1 b1) (bvmul (u d2) (u d2)))
                  (bvmul (n a2 b2) (bvmul (u d1) (u d1)))))
(check-sat)
; Negative control: remove the equality premise, modeling a stale relation.
(reset-assertions)
(assert (= a1 (_ bv1 4)))
(assert (= a2 (_ bv2 4)))
(assert (= b1 (_ bv0 4)))
(assert (= b2 (_ bv0 4)))
(assert (= d1 (_ bv1 4)))
(assert (= d2 (_ bv1 4)))
(assert (distinct (bvmul (n a1 b1) (bvmul (u d2) (u d2)))
                  (bvmul (n a2 b2) (bvmul (u d1) (u d1)))))
(check-sat)
