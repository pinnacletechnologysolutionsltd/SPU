; Abstract certificate rules, not an encoding of the Python checker.
(set-logic QF_BV)
(declare-const a (_ BitVec 3)) (declare-const b (_ BitVec 3)) (declare-const k (_ BitVec 3))
(declare-const f Bool)
(define-fun s ((x (_ BitVec 3))) (_ BitVec 16) ((_ sign_extend 13) x))
(define-fun norm ((x (_ BitVec 16)) (y (_ BitVec 16))) (_ BitVec 16)
  (bvsub (bvmul x x) (bvmul (_ bv3 16) (bvmul y y))))
(assert (or (= k #b110) (= k #b111) (= k #b000) (= k #b001) (= k #b010)))
; Checked NORM rule: projection after scaling/conjugation uses k squared.
(assert (distinct (norm (bvmul (s k) (s a)) (bvmul (s k) (ite f (bvneg (s b)) (s b))))
                  (bvmul (bvmul (s k) (s k)) (norm (s a) (s b)))))
(check-sat)
; Incorrect NORM rule uses k, not k squared.
(reset-assertions)
(assert (= a #b001)) (assert (= b #b000)) (assert (= k #b010))
(assert (distinct (norm (bvmul (s k) (s a)) (bvmul (s k) (s b)))
                  (bvmul (s k) (norm (s a) (s b)))))
(check-sat)
(get-value (a b k))
; Coverage: if both declared-feasible witnesses are sound, no feasible path is false.
(reset-assertions)
(declare-const f1 Bool) (declare-const f2 Bool)
(declare-const w1 Bool) (declare-const w2 Bool)
(declare-const t1 Bool) (declare-const t2 Bool)
(assert (or f1 f2)) (assert (=> f1 w1)) (assert (=> f2 w2))
(assert (=> (and f1 w1) t1)) (assert (=> (and f2 w2) t2))
(assert (or (and f1 (not t1)) (and f2 (not t2))))
(check-sat)
; Defective any-branch coverage accepts a false feasible second path.
(reset-assertions)
(assert f1) (assert f2) (assert w1) (assert (not w2)) (assert t1) (assert (not t2))
(assert (or (and f1 w1) (and f2 w2)))
(check-sat)
(get-value (f1 f2 w1 w2 t1 t2))
; Binding old identity to an incremented two-bit identity cannot match after one write.
(reset-assertions)
(declare-const old (_ BitVec 2))
(define-fun new () (_ BitVec 2) (bvadd old (_ bv1 2)))
(assert (= old new))
(check-sat)
; Mutant ignores identity and matches only the unchanged register number.
(reset-assertions)
(assert (distinct old new))
(check-sat)
(get-value (old new))
