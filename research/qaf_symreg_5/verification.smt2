; Abstract lifecycle: bounded booleans and two-bit epoch/identity values.
; SAT controls demonstrate defects; this does not encode Python.
(set-logic QF_BV)
(declare-const old (_ BitVec 2))
(declare-const new (_ BitVec 2))
(declare-const oldid (_ BitVec 2))
(declare-const newid (_ BitVec 2))
(declare-const branchA Bool)
(declare-const branchB Bool)
(push)
(assert (distinct old new))
(assert (= old new))
(check-sat)
(pop)
; Mutant checks label only, not epoch: stale epoch is accepted.
(push)
(assert (distinct old new))
(check-sat)
(get-value (old new))
(pop)
(push)
(assert (distinct oldid newid))
(assert (= oldid newid))
(check-sat)
(pop)
; Mutant checks register number instead of identity.
(push)
(assert (distinct oldid newid))
(check-sat)
(get-value (oldid newid))
(pop)
(push)
(assert branchA)
(assert branchB)
(assert (not (and branchA branchB)))
(check-sat)
(pop)
; Mutant admits any one witness rather than both declared branches.
(push)
(assert branchA)
(assert (not branchB))
(check-sat)
(get-value (branchA branchB))
(pop)
; Trust requires premise authorization; mutant ignores it.
(declare-const authorized Bool)
(push)
(assert authorized)
(assert (not authorized))
(check-sat)
(pop)
(push)
(assert (not authorized))
(check-sat)
(get-value (authorized))
(pop)
